diff --git a/fusion-core-android/app/src/test/java/app/fusion/wallet/ownersend/OwnerSendBoundaryTest.kt b/fusion-core-android/app/src/test/java/app/fusion/wallet/ownersend/OwnerSendBoundaryTest.kt
