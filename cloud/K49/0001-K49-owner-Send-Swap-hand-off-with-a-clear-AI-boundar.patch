+private fun usdc(whole: Long, frac: Long = 0) = BigInteger.valueOf(whole).multiply(BigInteger.TEN.pow(6)).add(BigInteger.valueOf(frac))
+private fun m(whole: Long) = Money(usdc(whole))
+
+internal object OwnerFx {
+    const val NOW = 1_760_000_000L
+    const val SAFE = "0x029869910714D9e09b854a2688311AFd42fBb44E"
+    const val TOKEN = "0xba50Cd2A20f6DA35D788639E581bca8d0B5d4D5f"
+    const val MODULE = "0xA560ec10259657E9bADd297E68286d2838Cd5a8f"
+    const val VAULT_A = "0xf430cb6E2b85f99222fBFA6dFEa18Ff60FA6B32a"
+    const val VAULT_B = "0xf052C0ED8404adEaAEA773A5F8Ae4628134aff6D"
+    const val ACME = "0x61dd06cE2f07d3E4F97d097741b0D7FD50F97F79"
+    const val COOLING = "0xC78Be9Da2204CC3020B055520102479FA3175066"
+    const val STRANGER = "0x208Bfee9F222d611b4Db71d5ee53b3dAB1A2188A"
+    const val GUARDIAN = "0x46B8E40EB9767BD46E03C5eCF398C10E1372251E"
+
+    val policy = Policy(PermissionTier.AUTONOMOUS, m(100), m(10), m(50), m(100), m(4000), 300, 50, GUARDIAN, 86_400, 259_200)
+
+    /** Cash 2,500, owed 58, cushion 100, so free 2,442 and spare cash 2,342. Computed by the real BucketMath. */
+    fun state(
+        status: LoadStatus = LoadStatus.READY,
+        cash: Long = 2500,
+        owed: Long = 58,
+        accountingMatches: Boolean? = true,
+        capturedAt: Long = NOW * 1000,
+    ): WalletState = WalletState(
+        status = status, blockNumber = 30_000_000, blockTime = NOW, capturedAtEpochMillis = capturedAt, observedHeadBlock = 30_000_000,
+        treasury = Treasury(SAFE, TOKEN, m(cash)),
+        buckets = BucketMath.compute(m(cash).raw, m(owed).raw, m(100).raw, m(400).raw),
+        vaults = listOf(
+            VaultPosition("vaultA", "Aave vault", VAULT_A, BigInteger.ONE, m(300), m(300), m(1000)),
+            VaultPosition("vaultB", "Demo vault", VAULT_B, BigInteger.ONE, m(100), m(100), m(500)),
+        ),
+        module = ModuleState(
+            address = MODULE, configured = true, paused = false, sessionActive = true, policy = policy,
+            policyEpoch = BigInteger.valueOf(7), policyHash = "0x" + "11".repeat(32), mandateHash = "0x" + "22".repeat(32),
+            obligationsRoot = "0x" + "33".repeat(32), reserved = m(owed), obligationCount = BigInteger.TWO, actionNonce = BigInteger.TEN,
+            dailyUsed = m(20), dailyRemaining = m(3980), sessionId = "0x" + "44".repeat(32), sessionKey = "0x5e55100000000000000000000000000000000001",
+            sessionExpiresAt = NOW + 3600, sessionLimit = m(8000), sessionUsed = m(20),
+        ),
+        payees = listOf(
+            Payee("acme", ACME, "Acme Hosting", "0x" + "aa".repeat(32), PayeeStatus.ACTIVE, NOW - 10, false),
+            Payee("newbank", COOLING, "Acme new bank details", "0x" + "bb".repeat(32), PayeeStatus.COOLING, NOW + 3000, false),
+        ),
+        accountingMatches = accountingMatches,
+    )
+}
+
+class OwnerSendTest {
+    private val now = OwnerFx.NOW * 1000
+    private val ctx = RecipientContext.from(OwnerFx.state())!!
+
+    // ---- calldata ---------------------------------------------------------------------------------
+
+    @Test fun erc20_transfer_calldata_has_the_exact_bytes() {
+        // Expected strings were computed independently (Python): selector + 32-byte padded address + 32-byte padded amount.
+        assertEquals(
+            "0xa9059cbb" +
+                "00000000000000000000000061dd06ce2f07d3e4f97d097741b0d7fd50f97f79" +
