+++ b/fusion-core-android/app/src/test/java/app/fusion/wallet/ownersend/OwnerSendBoundaryTest.kt
@@ -0,0 +1,79 @@
+package app.fusion.wallet.ownersend
+
+import java.io.File
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * K49 boundary: Send/Swap only BUILD a transaction for the owners. They must not reach any signer, session,
+ * planner or agent-runtime class, and must not sign or broadcast. This scans the real source files.
+ */
+internal object BoundaryScanner {
+    private val blockComment = Regex("(?s)/\\*.*?\\*/")
+    private val lineComment = Regex("(?<!:)//[^\\n]*")
+
+    /** Packages the agent, signer and planner live in. Importing anything from them is a violation. */
+    private val forbiddenImport = Regex("""^\s*import\s+app\.fusion\.wallet\.(agent|signer|inference)\b""")
+
+    /** Class and function names that carry signing, session, planning or agent authority. */
+    private val forbiddenName = Regex(
+        """\b(AgentRuntime|AgentNetwork|AutopilotController|SessionSigner\w*|SessionKeys|SessionEntryPoints|SessionSigningPolicy|""" +
+            """GuardianKeyStore|GuardianSigner\w*|GuardianTransaction|GuardianPauseEngine|GuardianStopDialog|PlannerClient|PlannerService|""" +
+            """NativePlanner|MainViewModel|requestGuardianPause|runAgentTick|signTransaction|sendRawTransaction|eth_sendRawTransaction)\b""",
+    )
+
+    fun strip(source: String) = source.replace(blockComment, "").replace(lineComment, "")
+
+    fun violations(fileName: String, source: String): List<String> =
+        strip(source).lines().flatMapIndexed { i, line ->
+            buildList {
+                if (forbiddenImport.containsMatchIn(line)) add("$fileName:${i + 1} imports agent/signer/inference: ${line.trim()}")
+                forbiddenName.find(line)?.let { add("$fileName:${i + 1} uses ${it.value}") }
+            }
+        }
+}
+
+class OwnerSendBoundaryTest {
+    private val roots = listOf("src/main/java/app/fusion/wallet/ownersend", "src/main/java/app/fusion/wallet/ui/send")
+
+    private fun sourceFiles(): List<File> {
+        val base = System.getProperty("k49.appDir")?.let(::File) ?: File(".")
+        return roots.flatMap { r -> File(base, r).listFiles { f -> f.extension == "kt" }?.toList().orEmpty() }
+    }
+
+    @Test fun send_and_swap_sources_are_found() {
+        val names = sourceFiles().map { it.name }.toSet()
+        // A wrong working directory must fail loudly instead of scanning nothing.
+        assertTrue("sources not found, got $names", names.containsAll(setOf("OwnerSend.kt", "WhoCanDoWhat.kt", "OwnerSendSheet.kt", "WhoCanDoWhatUi.kt")))
+    }
+
+    @Test fun send_and_swap_code_touches_no_signer_session_planner_or_agent_runtime() {
+        val found = sourceFiles().flatMap { BoundaryScanner.violations(it.name, it.readText()) }
+        assertEquals("boundary violations:\n" + found.joinToString("\n"), emptyList<String>(), found)
+    }
+
+    @Test fun the_scanner_catches_violations() {
+        val bad = listOf(
+            "import app.fusion.wallet.agent.AgentRuntime",
+            "import app.fusion.wallet.signer.GuardianStopDialog",
+            "import app.fusion.wallet.inference.PlannerClient",
+            "val r = AgentRuntime.run(context, repo, false)",
+            "SessionSignerClient(context).sign(tx)",
+            "vm.requestGuardianPause()",
+            "rpc.call(\"eth_sendRawTransaction\", raw)",
+        )
+        for (line in bad) assertTrue("missed: $line", BoundaryScanner.violations("Bad.kt", line).isNotEmpty())
+    }
+
+    @Test fun comments_and_strings_with_urls_do_not_hide_or_cause_violations() {
+        val ok = """
+            // AgentRuntime is mentioned only in a comment
+            /* import app.fusion.wallet.signer.Something */
+            val link = "https://app.safe.global/home?safe=basesep:0xabc"
+        """.trimIndent()
+        assertEquals(emptyList<String>(), BoundaryScanner.violations("Ok.kt", ok))
+        // A violation after a URL on the same line is still seen.
+        assertTrue(BoundaryScanner.violations("Bad.kt", "val x = \"https://a.b\"; AgentRuntime.run()").isNotEmpty())
+    }
+}
