+import com.google.zxing.qrcode.QRCodeWriter
+
+const val OWNER_BOUNDARY_LABEL = "Owner-signed 2-of-2 · this app holds no owner keys · the AI cannot send"
+
+/**
+ * Owner Send / Swap (K49). It builds the Safe transaction and hands off to Safe{Wallet}. Nothing is signed or sent
+ * from this app. It takes only the live WalletState; it has no handle on any signer, session or agent runtime.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun OwnerSendSheet(state: WalletState, onDismiss: () -> Unit) {
+    var swap by rememberSaveable { mutableStateOf(false) }
+    ModalBottomSheet(onDismissRequest = onDismiss, sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)) {
+        Column(
+            Modifier.fillMaxWidth().verticalScroll(rememberScrollState()).padding(horizontal = 24.dp).padding(bottom = 24.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            Text(if (swap) "Swap" else "Send USDC", style = FusionType.HeadingMedium)
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                FilterChip(selected = !swap, onClick = { swap = false }, label = { Text("Send") })
+                FilterChip(selected = swap, onClick = { swap = true }, label = { Text("Swap") })
+            }
+            Text(OWNER_BOUNDARY_LABEL, style = FusionType.BodySmall, color = FusionColors.Amber)
+            if (swap) SwapPane(state) else SendPane(state)
+        }
+    }
+}
+
+@Composable
+private fun SwapPane(state: WalletState) {
+    val context = LocalContext.current
+    Text(SwapHandoff.HEADLINE, style = FusionType.BodyMedium)
+    Text(SwapHandoff.networkNote, style = FusionType.BodyMedium, color = FusionColors.Amber)
+    Text("No quote is shown because this app does not fetch or route swaps.", style = FusionType.BodySmall, color = FusionColors.TextMuted)
+    OpenInSafe(state, context)
+}
+
+@Composable
+private fun OpenInSafe(state: WalletState, context: Context) {
+    val safe = state.treasury?.safeAddress
+    Button(
+        onClick = { safe?.let { context.startActivitySafe(Intent(Intent.ACTION_VIEW, Uri.parse(SafeWalletLink.home(it)))) } },
+        enabled = safe != null,
+        modifier = Modifier.fillMaxWidth().heightIn(min = 48.dp),
+    ) { Text("Open in Safe{Wallet}") }
+    if (safe == null) Text("Safe address unavailable until the chain snapshot loads.", style = FusionType.BodySmall, color = FusionColors.TextMuted)
+}
+
+@Composable
+private fun SendPane(state: WalletState) {
+    val context = LocalContext.current
+    var recipient by rememberSaveable { mutableStateOf("") }
+    var amount by rememberSaveable { mutableStateOf("") }
+    var ack by rememberSaveable { mutableStateOf(false) }
+    val eval = remember(state, recipient, amount, ack) { OwnerSend.evaluate(state, recipient, amount, ack, System.currentTimeMillis()) }
+    val symbol = eval.live?.symbol ?: "USDC"
+
+    OutlinedTextField(
+        value = recipient, onValueChange = { recipient = it.trim().take(66); ack = false }, modifier = Modifier.fillMaxWidth(),
+        label = { Text("Recipient address (0x…)") }, singleLine = true,
+    )
+    when (val r = eval.recipient) {
+        null -> {}
+        is RecipientCheck.Invalid -> Text(r.reason, style = FusionType.BodySmall, color = FusionColors.Red)
+        is RecipientCheck.Valid -> {
+            Text(r.address, style = FusionType.NumberCaption)
+            r.knownPayee?.let { Text("Known payee: $it", style = FusionType.BodySmall, color = FusionColors.Green) }
+            r.warnings.forEach { Text("⚠ $it", style = FusionType.BodySmall, color = FusionColors.Amber) }
+        }
+    }
+    OutlinedTextField(
+        value = amount, onValueChange = { amount = it.trim().take(20); ack = false }, modifier = Modifier.fillMaxWidth(),
+        label = { Text("Amount ($symbol)") }, singleLine = true, keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+    )
+    eval.amountError?.let { Text(it, style = FusionType.BodySmall, color = FusionColors.Red) }
+
+    eval.notReady?.let { Text(it, style = FusionType.BodySmall, color = FusionColors.Amber) }
+    eval.live?.let { live ->
+        Text("Spare cash ${formatBigIntegerAmount(live.spareCash)} $symbol · Safe holds ${formatBigIntegerAmount(live.safeCash)} $symbol",
+            style = FusionType.BodySmall, color = FusionColors.TextMuted)
+        if (live.stale) Text("Balances may be out of date. Refresh before you rely on this check.", style = FusionType.BodySmall, color = FusionColors.Amber)
+    }
+    when (val v = eval.verdict) {
+        null -> {}
+        is ReserveVerdict.Covered ->
+            if (v.billsUnverified) Text("Bill coverage could not be verified, so spare cash may be wrong. Confirm below to continue.",
+                style = FusionType.BodyMedium, color = FusionColors.Amber)
+            else Text("Bills and safety cushion stay covered", style = FusionType.BodyMedium, color = FusionColors.Green)
+        is ReserveVerdict.DipsIntoReserve ->
+            Text("This would dip into reserved bills/cushion by ${formatBigIntegerAmount(v.by)} $symbol", style = FusionType.BodyMedium, color = FusionColors.Red)
+        ReserveVerdict.ExceedsSafeBalance ->
+            Text("More than the Safe holds. This transaction would fail.", style = FusionType.BodyMedium, color = FusionColors.Red)
+    }
+    if (eval.needsAcknowledgement) {
+        Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+            Switch(checked = ack, onCheckedChange = { ack = it }, modifier = Modifier.semantics { contentDescription = "I understand" })
+            Text("I understand", style = FusionType.BodyMedium)
+        }
+    }
+
+    eval.tx?.let { tx -> Payload(tx, symbol) }
+    OpenInSafe(state, context)
+}
+
+@Composable
+private fun Payload(tx: OwnerSafeTx, symbol: String) {
+    val context = LocalContext.current
+    val json = remember(tx) { tx.toJson() }
+    val qr = remember(json) { QRCodeWriter().encode(json, BarcodeFormat.QR_CODE, 0, 0) }
+    var copied by remember { mutableStateOf<String?>(null) }
+    fun copy(label: String, text: String) {
+        (context.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager).setPrimaryClip(ClipData.newPlainText(label, text))
+        copied = "$label copied"
+    }
+    Text("Safe transaction for both owners to sign", style = FusionType.HeadingSmall)
+    Field("Network", "Base Sepolia (chain ${tx.chainId})")
+    Field("Safe", tx.safe) { copy("Safe", tx.safe) }
+    Field("To ($symbol token)", tx.to) { copy("To", tx.to) }
+    Field("Value", tx.value)
+    Field("Operation", "${tx.operation} (CALL)")
+    Field("Data (ERC-20 transfer)", tx.data) { copy("Data", tx.data) }
+    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.Center) {
+        Canvas(Modifier.size(220.dp).background(Color.White).semantics {
+            contentDescription = "QR code of the Safe transaction JSON"
+        }) {
+            val cell = size.minDimension / qr.width
+            for (y in 0 until qr.height) for (x in 0 until qr.width) if (qr[x, y]) {
+                drawRect(Color.Black, Offset(x * cell, y * cell), Size(cell, cell))
+            }
+        }
+    }
+    OutlinedButton(onClick = { copy("Transaction JSON", json) }, modifier = Modifier.fillMaxWidth().heightIn(min = 48.dp)) { Text("Copy transaction JSON") }
+    copied?.let { Text(it, style = FusionType.BodySmall, color = FusionColors.Green) }
+    Text("Nothing is signed or sent from this app. Create this same transaction in Safe{Wallet}; both owners must sign it there.",
+        style = FusionType.BodySmall, color = FusionColors.TextMuted)
+}
+
+@Composable
+private fun Field(label: String, value: String, onCopy: (() -> Unit)? = null) {
+    Column {
+        Text(label, style = FusionType.BodySmall, color = FusionColors.TextMuted)
+        SelectionContainer { Text(value, style = FusionType.NumberCaption) }
+        if (onCopy != null) OutlinedButton(onClick = onCopy, modifier = Modifier.heightIn(min = 48.dp)) { Text("Copy $label") }
+    }
+}
