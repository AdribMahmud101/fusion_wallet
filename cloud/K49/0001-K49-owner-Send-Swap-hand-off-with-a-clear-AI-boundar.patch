+package app.fusion.wallet.ownersend
+
+import app.fusion.wallet.data.ModuleState
+import app.fusion.wallet.data.Money
+import app.fusion.wallet.data.allowanceCopy
+
+data class RoleLine(val role: String, val can: String)
+
+/**
+ * The authority split in one place: owners are sovereign, the guardian only stops things, the AI acts only inside
+ * on-chain limits. The AI's limits come from the same allowance formatter as Home, Agent and Safety.
+ */
+object WhoCanDoWhat {
+    const val OWNER = "Send · Swap · policy · resume"
+    const val GUARDIAN = "pause · cancel queued"
+    const val AI_ACTIONS = "Deposit · Withdraw · Pay verified bills · Hold"
+
+    /** The deployed contract rejects REBALANCE (`UnsupportedAction`), so it is not listed as an AI power. */
+    const val AI_NOT_SUPPORTED = "Rebalance is not supported by the deployed contract."
+
+    fun aiLimits(module: ModuleState?, format: (Money) -> String): String {
+        module ?: return "limits unavailable until the policy loads"
+        val copy = allowanceCopy(module.policy, module.dailyUsed, format)
+        return "${copy.perMove.removePrefix("Per move: ")} · ${copy.dailyCap.removePrefix("Daily cap: ")} daily cap"
+    }
+
+    fun lines(module: ModuleState?, format: (Money) -> String): List<RoleLine> = listOf(
+        RoleLine("Owner (2-of-2)", OWNER),
+        RoleLine("Guardian", GUARDIAN),
+        RoleLine("AI agent", "$AI_ACTIONS, within on-chain limits: ${aiLimits(module, format)}"),
+    )
+
+    /** Compact text for under the Home hero. */
+    fun compact(module: ModuleState?, format: (Money) -> String): List<String> = listOf(
+        "Owner (2-of-2): $OWNER · Guardian: $GUARDIAN",
+        "AI agent: $AI_ACTIONS · ${aiLimits(module, format)}",
+    )
+}
