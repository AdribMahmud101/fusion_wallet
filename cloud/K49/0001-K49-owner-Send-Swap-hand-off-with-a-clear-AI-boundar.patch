+package app.fusion.wallet.ownersend
+
+import app.fusion.wallet.chain.Abi
+import app.fusion.wallet.data.LoadStatus
+import app.fusion.wallet.data.Payee
+import app.fusion.wallet.data.PayeeStatus
+import app.fusion.wallet.data.WalletState
+import java.math.BigDecimal
+import java.math.BigInteger
+import org.bouncycastle.crypto.digests.KeccakDigest
+
+/*
+ * K49: the owner's Send path. This package only BUILDS the Safe transaction the two owners must sign.
+ * It holds no key and signs, broadcasts and plans nothing, so it imports no signer, session, planner or
+ * AgentRuntime class (enforced by OwnerSendBoundaryTest). The owners sign in Safe{Wallet}.
+ */
+
+/** EIP-55 mixed-case checksum addresses. */
+object Eip55 {
+    private val HEX40 = Regex("^0x[0-9a-fA-F]{40}$")
+
+    private fun keccakHex(bytes: ByteArray): String {
+        val out = ByteArray(32)
+        KeccakDigest(256).apply { update(bytes, 0, bytes.size); doFinal(out, 0) }
+        return out.joinToString("") { "%02x".format(it.toInt() and 255) }
+    }
+
+    fun isAddress(s: String) = HEX40.matches(s)
+
+    fun toChecksum(address: String): String {
+        require(isAddress(address)) { "Not a 20-byte hex address" }
+        val lower = address.drop(2).lowercase()
+        val hash = keccakHex(lower.toByteArray(Charsets.US_ASCII))
+        return "0x" + lower.mapIndexed { i, c -> if (c.isLetter() && hash[i] >= '8') c.uppercaseChar() else c }.joinToString("")
+    }
+
+    /** True for an all-lower or all-upper address (no checksum claimed) or a correct mixed-case one. */
+    fun checksumConsistent(address: String): Boolean {
+        if (!isAddress(address)) return false
+        val body = address.drop(2)
+        val mixed = body.any { it.isLowerCase() } && body.any { it.isUpperCase() }
+        return !mixed || toChecksum(address) == address
+    }
+}
+
+/** ERC-20 `transfer(address,uint256)` calldata, built with the app's existing ABI word helpers. */
+object Erc20Calldata {
+    const val TRANSFER_SELECTOR = "0xa9059cbb"
+
+    fun transfer(recipient: String, amountRaw: BigInteger): String {
+        require(amountRaw.signum() > 0) { "Amount must be above zero" }
+        return TRANSFER_SELECTOR + Abi.addressWord(recipient) + Abi.uintWord(amountRaw)
+    }
+}
+
+/** A USDC amount typed by a person: plain decimal, at most 6 places, above zero. */
+object UsdcInput {
+    sealed interface Result {
+        data class Ok(val raw: BigInteger) : Result
+        data class Error(val reason: String) : Result
+    }
+
+    private val FORMAT = Regex("^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$")
+
+    fun parse(text: String): Result {
+        val t = text.trim()
+        if (t.isEmpty()) return Result.Error("Enter an amount")
+        if (!FORMAT.matches(t)) return Result.Error("Use digits with up to 6 decimals, for example 25.50")
+        val raw = BigDecimal(t).movePointRight(6).toBigIntegerExact()
+        return if (raw.signum() == 0) Result.Error("Amount must be above 0") else Result.Ok(raw)
+    }
+}
+
+/** Addresses of this treasury that make a recipient special. Built from the live WalletState. */
+data class RecipientContext(
+    val safe: String,
+    val token: String,
+    val module: String?,
+    val vaults: List<String>,
+    val payees: List<Payee>,
+) {
+    companion object {
+        fun from(state: WalletState): RecipientContext? {
+            val t = state.treasury ?: return null
+            return RecipientContext(t.safeAddress, t.assetAddress, state.module?.address, state.vaults.map { it.address }, state.payees)
+        }
+    }
+}
+
+sealed interface RecipientCheck {
+    data class Invalid(val reason: String) : RecipientCheck
+
+    /** [address] is the checksummed form. [knownPayee] is the label of an ACTIVE registered payee. */
+    data class Valid(val address: String, val knownPayee: String?, val warnings: List<String>) : RecipientCheck
+}
+
+object RecipientValidator {
+    private const val ZERO = "0x0000000000000000000000000000000000000000"
+
+    fun check(input: String, ctx: RecipientContext): RecipientCheck {
+        val text = input.trim()
+        if (!Eip55.isAddress(text)) return RecipientCheck.Invalid("Enter a 0x address with 40 hex characters")
+        if (!Eip55.checksumConsistent(text)) return RecipientCheck.Invalid("The capital letters do not match this address's checksum. Check each character")
+        val address = Eip55.toChecksum(text)
+        if (address.equals(ZERO, true)) return RecipientCheck.Invalid("The zero address would burn the funds")
+        if (address.equals(ctx.safe, true)) return RecipientCheck.Invalid("That is this treasury's own Safe")
+
+        val warnings = mutableListOf<String>()
+        val own = when {
+            address.equals(ctx.token, true) -> "the USDC token contract"
+            ctx.module?.equals(address, true) == true -> "the Kavachi module"
+            ctx.vaults.any { it.equals(address, true) } -> "one of this treasury's vaults"
+            else -> null
+        }
+        if (own != null) warnings += "This is $own. Funds sent to a contract may be unrecoverable"
+
+        val payee = ctx.payees.firstOrNull { it.address.equals(address, true) }
+        var known: String? = null
+        when {
+            payee == null -> warnings += "Not a known payee. Confirm the address with the recipient"
+            payee.status == PayeeStatus.ACTIVE -> known = payee.label
+            payee.status == PayeeStatus.COOLING -> warnings += "${payee.label} is a registered payee still in its cooling period"
+            else -> warnings += "${payee.label} was a payee but is cancelled"
+        }
+        return RecipientCheck.Valid(address, known, warnings)
+    }
+}
+
+/** The live numbers the reserve check reads. Nothing here is typed in or estimated. */
+data class LiveBalances(
+    /** The "Spare cash" bucket: cash left after reserved bills and the safety cushion. */
+    val spareCash: BigInteger,
+    /** All USDC the Safe holds. */
+    val safeCash: BigInteger,
+    /** True when the bill metadata matches the on-chain commitment, so the buckets can be trusted. */
+    val billsVerified: Boolean,
+    /** True when the snapshot is older than the display freshness limit. */
+    val stale: Boolean,
+    val symbol: String,
+) {
+    companion object {
+        /** Null unless a ready snapshot with buckets and a treasury is loaded. */
+        fun from(state: WalletState, nowMillis: Long): LiveBalances? {
+            val buckets = state.buckets ?: return null
+            val treasury = state.treasury ?: return null
+            if (state.status != LoadStatus.READY) return null
+            return LiveBalances(buckets.surplus.raw, treasury.balance.raw, state.accountingMatches == true, state.isDisplayStale(nowMillis), treasury.symbol)
+        }
+    }
+}
+
+sealed interface ReserveVerdict {
+    /** Amount is within spare cash. [billsUnverified] means the buckets could not be cross-checked. */
+    data class Covered(val billsUnverified: Boolean) : ReserveVerdict
+
+    /** Amount is above spare cash by [by]; the difference comes out of reserved bills or the cushion. */
+    data class DipsIntoReserve(val by: BigInteger) : ReserveVerdict
+
+    /** More than the Safe holds. The transaction would revert, so no payload is built. */
+    data object ExceedsSafeBalance : ReserveVerdict
+
+    val needsAcknowledgement: Boolean
+        get() = this is DipsIntoReserve || (this is Covered && billsUnverified)
+}
+
+object ReserveCheck {
+    fun evaluate(amountRaw: BigInteger, live: LiveBalances): ReserveVerdict = when {
+        amountRaw > live.safeCash -> ReserveVerdict.ExceedsSafeBalance
+        amountRaw <= live.spareCash -> ReserveVerdict.Covered(billsUnverified = !live.billsVerified)
+        else -> ReserveVerdict.DipsIntoReserve(amountRaw - live.spareCash)
+    }
+}
+
+/** The exact transaction the owners must sign in the Safe. Operation 0 is CALL. */
+data class OwnerSafeTx(
+    val chainId: Long,
+    val safe: String,
+    val to: String,
+    val value: String,
+    val data: String,
+    val operation: Int,
+) {
+    /** Stable field order, so the QR and the copied text are identical every time. */
+    fun toJson(): String =
+        """{"chainId":$chainId,"safe":"$safe","to":"$to","value":"$value","data":"$data","operation":$operation}"""
+}
+
+object SafeWalletLink {
+    /** `basesep` is Safe{Wallet}'s prefix for Base Sepolia. */
+    fun home(safeAddress: String) = "https://app.safe.global/home?safe=basesep:${Eip55.toChecksum(safeAddress)}"
+}
+
+data class SendEvaluation(
+    /** Set when the live data needed for the reserve check is missing. Nothing is built. */
+    val notReady: String?,
+    val live: LiveBalances?,
+    /** Null when the recipient field is empty. */
+    val recipient: RecipientCheck?,
+    val amountRaw: BigInteger?,
+    val amountError: String?,
+    val verdict: ReserveVerdict?,
+    val needsAcknowledgement: Boolean,
+    /** Present only when recipient, amount and the reserve check all pass and any acknowledgement was given. */
+    val tx: OwnerSafeTx?,
+)
+
+object OwnerSend {
+    fun evaluate(state: WalletState, recipientText: String, amountText: String, acknowledged: Boolean, nowMillis: Long): SendEvaluation {
+        val live = LiveBalances.from(state, nowMillis)
+        val ctx = RecipientContext.from(state)
+        if (live == null || ctx == null) {
+            return SendEvaluation("Live balances are not loaded yet. Refresh and try again", null, null, null, null, null, false, null)
+        }
+        val recipient = if (recipientText.isBlank()) null else RecipientValidator.check(recipientText, ctx)
+        val amount = if (amountText.isBlank()) null else UsdcInput.parse(amountText)
+        val raw = (amount as? UsdcInput.Result.Ok)?.raw
+        val verdict = raw?.let { ReserveCheck.evaluate(it, live) }
+        val needsAck = verdict?.needsAcknowledgement == true
+        val buildable = recipient is RecipientCheck.Valid && verdict != null && verdict != ReserveVerdict.ExceedsSafeBalance &&
+            (!needsAck || acknowledged)
+        val tx = if (buildable) {
+            OwnerSafeTx(
+                chainId = state.chainId,
+                safe = Eip55.toChecksum(ctx.safe),
+                to = Eip55.toChecksum(ctx.token),
+                value = "0",
+                data = Erc20Calldata.transfer((recipient as RecipientCheck.Valid).address, raw!!),
+                operation = 0,
+            )
+        } else null
+        return SendEvaluation(null, live, recipient, raw, (amount as? UsdcInput.Result.Error)?.reason, verdict, needsAck, tx)
+    }
+}
+
+/** Swap is an honest hand-off to Safe{Wallet}. The app never quotes, routes or signs a swap. */
+object SwapHandoff {
+    /** We could not confirm that Safe{Wallet} swaps work on Base Sepolia. Flip only with evidence. */
+    const val CONFIRMED_ON_BASE_SEPOLIA = false
+
+    const val HEADLINE = "Swaps are owner-signed in Safe{Wallet}. The AI never swaps."
+    val networkNote: String =
+        if (CONFIRMED_ON_BASE_SEPOLIA) "Open Safe{Wallet} and choose Swap. Both owners must sign."
+        else "Swaps are not available on the Base Sepolia test network. This app does not quote or route swaps."
+}
